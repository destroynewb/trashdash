local function isHoldingItem()
    local success, result = pcall(function()
        local heldItemDisplay = player.PlayerGui.GameHUD.HeldItemDisplay
        return heldItemDisplay.Visible
    end)
    return success and result
end

local function findAllItems(itemName)
    local items = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name == itemName and obj:FindFirstChild("Prompt") then
            table.insert(items, obj)
        end
    end
    return items
end

local itemsConfig = {
    {name = "Bottle", bin = "RecyclingBin", stat = "bottles", emoji = "🍾"},
    {name = "milk", bin = "RecyclingBin", stat = "milk", emoji = "🥛"},
    {name = "Eggplant", bin = "CompostBin", stat = "eggplants", emoji = "🍆"},
    {name = "AppleCore", bin = "CompostBin", stat = "appleCores", emoji = "🍎"},
    {name = "charcoal", bin = "HazardousBin", stat = "charcoal", emoji = "⚫"},
    {name = "Battery", bin = "HazardousBin", stat = "batteries", emoji = "🔋"},
    {name = "Chip", bin = "GeneralBin", stat = "chips", emoji = "🍟"},
    {name = "Wrapper", bin = "GeneralBin", stat = "wrappers", emoji = "📄"}
}

local function updateAvailableItems()
    while isRunning do
        for _, config in ipairs(itemsConfig) do
            local items = findAllItems(config.name)
            availableStats[config.stat] = #items
        end
        updateStats()
        wait(1)
    end
end

local function goToPosition(targetPosition)
    if USE_TELEPORT then
        humanoidRootPart.CFrame = CFrame.new(targetPosition)
        wait(0.1)
    else
        humanoid:MoveTo(targetPosition)
        local timeOut = 10
        local startTime = tick()
        while (humanoidRootPart.Position - targetPosition).Magnitude > 5 and (tick() - startTime) < timeOut and isRunning and not isPaused do
            wait(0.1)
        end
    end
end

local function collectItem(item)
    local prompt = item:FindFirstChild("Prompt")
    if not prompt then return false end
    
    goToPosition(item.Position)
    
    if isPaused or not isRunning then return false end
    
    wait(0.2)
    
    for i = 1, 10 do
        if not isRunning or isPaused then return false end
        
        if isHoldingItem() then
            return true
        end
        
        if prompt:IsA("ProximityPrompt") then
            if fireproximityprompt then
                fireproximityprompt(prompt)
            end
        elseif prompt:IsA("ClickDetector") then
            if fireclickdetector then
                fireclickdetector(prompt)
            end
        end
        
        wait(0.1)
    end
    
    return isHoldingItem()
end

local function depositToBin(binName, useTeleport)
    if not isHoldingItem() then return false end
    
    local bin = workspace:FindFirstChild(binName)
    if not bin then return false end
    
    local depositPrompt = bin:FindFirstChild("DepositPrompt")
    if not depositPrompt then return false end
    
    if useTeleport then
        humanoidRootPart.CFrame = CFrame.new(bin.Position)
        wait(0.2)
    else
        humanoid:MoveTo(bin.Position)
        local timeOut = 10
        local startTime = tick()
        while (humanoidRootPart.Position - bin.Position).Magnitude > 5 and (tick() - startTime) < timeOut and isRunning and not isPaused do
            wait(0.1)
        end
        
        if isPaused or not isRunning then return false end
        
        wait(0.2)
    end
    
    for i = 1, 15 do
        if not isRunning or isPaused then return false end
        
        if not isHoldingItem() then
            return true
        end
        
        if depositPrompt:IsA("ProximityPrompt") then
            if fireproximityprompt then
                fireproximityprompt(depositPrompt)
            end
        elseif depositPrompt:IsA("ClickDetector") then
            if fireclickdetector then
                fireclickdetector(depositPrompt)
            end
        end
        
        wait(0.15)
    end
    
    return not isHoldingItem()
end

local function mainLoop()
    while isRunning do
        while isPaused do
            wait(0.5)
        end
        
        if not isRunning then break end
        
        local hasItems = false
        
        for _, config in ipairs(itemsConfig) do
            if not isRunning then break end
            
            while isPaused do
                wait(0.5)
            end
            
            if not isRunning then break end
            
            local items = findAllItems(config.name)
            
            if #items > 0 then
                hasItems = true
                local item = items[1]
                
                updateStatus("🔄 กำลังเก็บ " .. config.emoji .. " " .. config.name .. "...")
                
                if collectItem(item) then
                    if not isRunning or isPaused then break end
                    
                    updateStatus("📦 กำลังนำไปใส่ถัง...")
                    
                    if depositToBin(config.bin, USE_TELEPORT) then
                        stats[config.stat] = stats[config.stat] + 1
                        updateStats()
                    end
                end
                
                wait(0.1)
            end
        end
        
        if not hasItems then
            updateStatus("⏳ รอขยะ spawn ใหม่...")
            wait(3)
        end
    end
end

