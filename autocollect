local function isHoldingItem()
    local success, result = pcall(function()
        local heldItemDisplay = player.PlayerGui.GameHUD.HeldItemDisplay
        return heldItemDisplay.Visible
    end)
    return success and result
end

local function findAllItems(itemName)
    local items = {}
    if itemName == "AppleCore" then
        local appleCore = workspace:FindFirstChild("AppleCore")
        if appleCore then
            local handle = appleCore:FindFirstChild("Handle")
            if handle and handle:FindFirstChild("Prompt") then
                table.insert(items, handle)
            end
        end
    else
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj.Name == itemName and obj:FindFirstChild("Prompt") then
                table.insert(items, obj)
            end
        end
    end
    return items
end

